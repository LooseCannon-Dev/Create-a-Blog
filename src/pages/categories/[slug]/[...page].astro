---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import Pagination from '../../../components/Pagination.astro';
import PostList from '../../../components/PostList.astro';
import { CATEGORIES, PAGE_SIZE } from '../../../consts';
import { getPublishedPosts } from '../../../posts';

// 글이 없는 카테고리도 페이지를 만든다 (목록은 "아직 작성된 글이 없습니다."로 표시).
export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  return CATEGORIES.flatMap((c) =>
    paginate(
      // 고정 글(소개글)을 맨 위에 두고, 나머지는 최신 글이 위로 온다 (posts는 이미 최신순).
      posts
        .filter((post) => post.data.category === c.name)
        .sort((a, b) => Number(b.data.pinned) - Number(a.data.pinned)),
      { params: { slug: c.slug }, props: { name: c.name }, pageSize: PAGE_SIZE },
    ),
  );
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const { name, page } = Astro.props;
---

<Base title={name}>
  <h1>{name}</h1>
  <PostList posts={page.data} />
  <Pagination base={`categories/${slug}/`} current={page.currentPage} last={page.lastPage} />
</Base>
