---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { CATEGORIES } from '../../consts';
import { getPublishedPosts } from '../../posts';

// 글이 없는 카테고리도 페이지를 만든다 (목록은 "아직 작성된 글이 없습니다."로 표시).
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return CATEGORIES.map((c) => ({
    params: { slug: c.slug },
    props: {
      name: c.name,
      // 고정 글(소개글)을 맨 위에 두고, 나머지는 최신 글이 위로 온다 (posts는 이미 최신순).
      posts: posts
        .filter((post) => post.data.category === c.name)
        .sort((a, b) => Number(b.data.pinned) - Number(a.data.pinned)),
    },
  }));
}

const { name, posts } = Astro.props;
---

<Base title={name}>
  <h1>{name}</h1>
  <PostList posts={posts} />
</Base>
