---
import Base from '../layouts/Base.astro';
import { url } from '../consts';
---

<Base title="검색">
  <h1>검색</h1>
  <form class="search-form search-page-form" role="search">
    <input id="search-input" type="search" name="q" placeholder="제목, 내용, 태그로 검색" aria-label="글 검색" autofocus />
  </form>
  <p id="search-status" class="muted"></p>
  <ul id="search-results" class="post-list"></ul>
</Base>

<script is:inline define:vars={{ indexUrl: url('search.json'), base: url() }}>
  const input = document.getElementById('search-input');
  const status = document.getElementById('search-status');
  const list = document.getElementById('search-results');
  let posts = null;

  function escapeHtml(text) {
    return text.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
  }

  function render() {
    const q = input.value.trim().toLowerCase();
    const params = new URLSearchParams(location.search);
    if (q) params.set('q', input.value.trim()); else params.delete('q');
    history.replaceState(null, '', params.size ? `?${params}` : location.pathname);

    if (!q) {
      status.textContent = '검색어를 입력해 주세요.';
      list.innerHTML = '';
      return;
    }
    const words = q.split(/\s+/);
    const hits = posts.filter((p) => {
      const text = [p.title, p.description, p.tags.join(' '), p.body].join(' ').toLowerCase();
      return words.every((w) => text.includes(w));
    });
    status.textContent = `"${input.value.trim()}" 검색 결과 ${hits.length}개`;
    list.innerHTML = hits
      .map(
        (p) => `<li><a class="post-link" href="${base}posts/${encodeURIComponent(p.id)}/">
          <h2>${escapeHtml(p.title)}</h2><p>${escapeHtml(p.description)}</p></a>
          <div class="meta">${p.tags.map((t) => `<a class="tag" href="${base}tags/${encodeURIComponent(t)}/">#${escapeHtml(t)}</a>`).join('')}</div></li>`,
      )
      .join('');
  }

  input.value = new URLSearchParams(location.search).get('q') ?? '';
  input.addEventListener('input', () => posts && render());
  document.querySelector('.search-page-form').addEventListener('submit', (e) => e.preventDefault());
  status.textContent = '불러오는 중…';
  fetch(indexUrl)
    .then((r) => {
      if (!r.ok) throw new Error(r.status);
      return r.json();
    })
    .then((data) => {
      posts = data;
      render();
    })
    .catch((err) => {
      status.textContent = `검색 목록을 불러오지 못했습니다. (${err.message})`;
    });
</script>
