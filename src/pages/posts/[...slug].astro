---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import { GOATCOUNTER_CODE, categorySlug, formatDate, thumbnailOf, url } from '../../consts';
import { getPublishedPosts } from '../../posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  // 목록이 최신순이라 앞 글이 더 새 글(다음 글), 뒤 글이 더 오래된 글(이전 글)이다.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
// 읽는 시간: 코드 블록·기호·공백을 뺀 글자 수를 분당 500자로 나눈 값 (최소 1분)
const textLength = (post.body ?? '')
  .replace(/```[\s\S]*?```/g, '')
  .replace(/<[^>]+>/g, '')
  .replace(/[#>*_`|~\-\[\]()!]/g, '')
  .replace(/\s+/g, '').length;
const readingMinutes = Math.max(1, Math.round(textLength / 500));
---

<Base title={post.data.title} description={post.data.description} image={thumbnailOf(post.data)} type="article">
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>약 {readingMinutes}분</span>
        {GOATCOUNTER_CODE && <span class="view-count" hidden>조회 <span data-views></span></span>}
        {post.data.category && (
          <a class="category" href={url(`categories/${categorySlug(post.data.category)}/`)}>{post.data.category}</a>
        )}
        {post.data.tags.map((tag) => <a class="tag" href={url(`tags/${tag}/`)}>#{tag}</a>)}
      </div>
    </header>
    {post.data.image && <img class="post-cover" src={url(post.data.image)} alt={post.data.imageAlt ?? ''} />}
    <div class="prose">
      <Content />
    </div>
  </article>
  {
    (older || newer) && (
      <nav class="post-nav" aria-label="이전 글과 다음 글">
        {older && (
          <a class="prev" href={url(`posts/${older.id}/`)}>
            <span>← 이전 글</span>
            {older.data.title}
          </a>
        )}
        {newer && (
          <a class="next" href={url(`posts/${newer.id}/`)}>
            <span>다음 글 →</span>
            {newer.data.title}
          </a>
        )}
      </nav>
    )
  }
  <Comments />
  {
    GOATCOUNTER_CODE && (
      <script is:inline define:vars={{ endpoint: `https://${GOATCOUNTER_CODE}.goatcounter.com/counter/` }}>
        // 이 글의 조회수(GoatCounter 방문자 수). 404는 아직 기록이 없는 글이라 0으로 본다.
        // 그 밖의 실패(접속 차단 등)는 숫자를 지어내지 않고 표시를 숨긴 채로 둔다.
        const views = document.querySelector('.view-count');
        fetch(`${endpoint}${encodeURIComponent(location.pathname)}.json`)
          .then((r) => {
            if (r.status === 404) return '0';
            if (!r.ok) throw new Error(`${location.pathname}: ${r.status}`);
            return r.json().then((d) => d.count);
          })
          .then((count) => {
            views.querySelector('[data-views]').textContent = count;
            views.hidden = false;
          })
          .catch((err) => console.warn('조회수를 불러오지 못했습니다.', err));
      </script>
    )
  }
  <dialog class="image-viewer" aria-label="사진 크게 보기">
    <img alt="" />
  </dialog>
  <script is:inline>
    // 글 사진을 누르면 화면 가득 크게 보여 준다. 아무 곳이나 누르거나 Esc로 닫는다.
    const viewer = document.querySelector('.image-viewer');
    const big = viewer.querySelector('img');
    document.querySelectorAll('.post-cover, .prose img').forEach((img) => {
      if (img.closest('a')) return;
      img.addEventListener('click', () => {
        big.src = img.currentSrc || img.src;
        big.alt = img.alt;
        viewer.showModal();
      });
    });
    viewer.addEventListener('click', () => viewer.close());
  </script>
</Base>
