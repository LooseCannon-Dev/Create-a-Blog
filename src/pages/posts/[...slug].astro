---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import { GOATCOUNTER_CODE, categorySlug, formatDate, thumbnailOf, url } from '../../consts';
import { getPublishedPosts } from '../../posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  // 목록이 최신순이라 앞 글이 더 새 글(다음 글), 뒤 글이 더 오래된 글(이전 글)이다.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
// 글 목차: 소제목(##, ###)이 5개 이상인 긴 글에만 보여 준다.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length >= 5;
// 읽는 시간: 코드 블록·기호·공백을 뺀 글자 수를 분당 500자로 나눈 값 (최소 1분)
const textLength = (post.body ?? '')
  .replace(/```[\s\S]*?```/g, '')
  .replace(/<[^>]+>/g, '')
  .replace(/[#>*_`|~\-\[\]()!]/g, '')
  .replace(/\s+/g, '').length;
const readingMinutes = Math.max(1, Math.round(textLength / 500));
---

<Base title={post.data.title} description={post.data.description} image={thumbnailOf(post.data)} type="article">
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>약 {readingMinutes}분</span>
        {GOATCOUNTER_CODE && <span class="view-count" data-views-path={url(`posts/${post.id}/`)} hidden>조회 <span data-views></span></span>}
        {post.data.category && (
          <a class="category" href={url(`categories/${categorySlug(post.data.category)}/`)}>{post.data.category}</a>
        )}
        {post.data.tags.map((tag) => <a class="tag" href={url(`tags/${tag}/`)}>#{tag}</a>)}
      </div>
    </header>
    {post.data.image && <img class="post-cover" src={url(post.data.image)} alt={post.data.imageAlt ?? ''} />}
    {
      showToc && (
        <details class="toc toc-inline">
          <summary>목차</summary>
          <ul>
            {toc.map((h) => (
              <li class={`toc-depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </details>
      )
    }
    <div class="prose">
      <Content />
    </div>
  </article>
  {
    (older || newer) && (
      <nav class="post-nav" aria-label="이전 글과 다음 글">
        {older && (
          <a class="prev" href={url(`posts/${older.id}/`)}>
            <span>← 이전 글</span>
            {older.data.title}
          </a>
        )}
        {newer && (
          <a class="next" href={url(`posts/${newer.id}/`)}>
            <span>다음 글 →</span>
            {newer.data.title}
          </a>
        )}
      </nav>
    )
  }
  <Comments />
  {
    showToc && (
      <nav class="side-box toc toc-side" slot="side" aria-label="목차">
        <h2>목차</h2>
        <ul>
          {toc.map((h) => (
            <li class={`toc-depth-${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <dialog class="image-viewer" aria-label="사진 크게 보기">
    <img alt="" />
  </dialog>
  <script is:inline>
    // 글 사진을 누르면 화면 가득 크게 보여 준다. 아무 곳이나 누르거나 Esc로 닫는다.
    const viewer = document.querySelector('.image-viewer');
    const big = viewer.querySelector('img');
    document.querySelectorAll('.post-cover, .prose img').forEach((img) => {
      if (img.closest('a')) return;
      img.addEventListener('click', () => {
        big.src = img.currentSrc || img.src;
        big.alt = img.alt;
        viewer.showModal();
      });
    });
    viewer.addEventListener('click', () => viewer.close());

    // 본문 코드 블록 오른쪽 위에 '복사' 버튼을 붙인다.
    document.querySelectorAll('.prose pre').forEach((pre) => {
      const wrap = document.createElement('div');
      wrap.className = 'code-block';
      pre.replaceWith(wrap);
      wrap.append(pre);
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code';
      button.textContent = '복사';
      wrap.append(button);
      button.addEventListener('click', () => {
        navigator.clipboard
          .writeText(pre.innerText.replace(/\n$/, ''))
          .then(() => (button.textContent = '복사됨'))
          .catch((err) => {
            console.warn('코드를 복사하지 못했습니다.', err);
            button.textContent = '복사 실패';
          })
          .finally(() => setTimeout(() => (button.textContent = '복사'), 1500));
      });
    });
  </script>
</Base>
