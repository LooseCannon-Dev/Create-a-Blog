---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import { SITE_TITLE, SITE_DESCRIPTION, GOATCOUNTER_CODE, DEFAULT_THUMBNAIL, url } from '../consts';

interface Props {
  title?: string;
  description?: string;
  // 공유 미리보기 이미지 (public 기준 경로). 없으면 로고를 쓴다.
  image?: string;
  type?: 'website' | 'article';
}

const { title, description = SITE_DESCRIPTION, image = DEFAULT_THUMBNAIL, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(url(image), Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('favicon-32.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url('rss.xml')} />
    <script is:inline>
      // 저장된 테마(light/dark)를 화면을 그리기 전에 적용한다. 없으면 기기 설정을 따른다.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (err) {
        console.warn('테마 설정을 읽지 못했습니다.', err);
      }
    </script>
    {
      GOATCOUNTER_CODE && (
        <script
          is:inline
          data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="site-title" href={url()}>{SITE_TITLE}</a>
        <nav>
          <a href={url()}>글 목록</a>
          <a href={url('tags/')}>태그</a>
          <a href={url('search/')}>검색</a>
          <button class="theme-toggle" type="button" aria-label="다크 모드 전환" title="다크 모드 전환">
            <span class="theme-icon-dark" aria-hidden="true">☾</span>
            <span class="theme-icon-light" aria-hidden="true">☀</span>
          </button>
        </nav>
      </div>
    </header>
    <div class="container layout">
      <main>
        <slot />
      </main>
      <Sidebar />
    </div>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} {SITE_TITLE}</span>
        <a href={url('rss.xml')}>RSS 구독</a>
      </div>
    </footer>
    <script is:inline>
      document.querySelector('.theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const isDark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = isDark ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (err) {
          console.warn('테마 설정을 저장하지 못했습니다.', err);
        }
        window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
      });
    </script>
  </body>
</html>
