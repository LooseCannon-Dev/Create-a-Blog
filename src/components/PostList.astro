---
import type { CollectionEntry } from 'astro:content';
import { GOATCOUNTER_CODE, categorySlug, formatDate, thumbnailOf, url } from '../consts';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

{posts.length === 0 && <p class="muted">아직 작성된 글이 없습니다.</p>}
<ul class="post-list">
  {
    posts.map((post) => (
      <li class:list={['post-item', { pinned: post.data.pinned }]}>
        <div class="post-text">
          <a class="post-link" href={url(`posts/${post.id}/`)}>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </a>
          <div class="meta">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            {GOATCOUNTER_CODE && (
              <span class="view-count" data-views-path={url(`posts/${post.id}/`)} hidden>
                조회 <span data-views></span>
              </span>
            )}
            {post.data.category && (
              <a class="category" href={url(`categories/${categorySlug(post.data.category)}/`)}>{post.data.category}</a>
            )}
            {post.data.tags.map((tag) => (
              <a class="tag" href={url(`tags/${tag}/`)}>#{tag}</a>
            ))}
          </div>
        </div>
        <a class="post-thumb" href={url(`posts/${post.id}/`)} tabindex="-1" aria-hidden="true">
          <img src={url(thumbnailOf(post.data))} alt="" loading="lazy" />
        </a>
      </li>
    ))
  }
</ul>
